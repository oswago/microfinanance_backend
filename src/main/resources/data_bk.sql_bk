DELETE FROM number_sequences;
DELETE FROM currency_settings;
DELETE FROM branches;
DELETE FROM system_settings;
DELETE FROM role_permissions;
DELETE FROM users;

SET REFERENTIAL_INTEGRITY TRUE;

