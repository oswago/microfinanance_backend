# 1. MFA Endpoints

# Login (returns MFA token if MFA enabled)
curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{"username":"admin","password":"admin123"}'

# Verify MFA
curl -X POST http://localhost:8080/api/auth/verify-mfa \
  -H "Authorization: Bearer <MFA_TOKEN>" \
  -H "Content-Type: application/json" \
  -d '{"code":"123456"}'

# Setup MFA
curl -X POST http://localhost:8080/api/auth/setup-mfa \
  -H "Authorization: Bearer <ACCESS_TOKEN>"

# Enable MFA
curl -X POST http://localhost:8080/api/auth/enable-mfa \
  -H "Authorization: Bearer <ACCESS_TOKEN>" \
  -H "Content-Type: application/json" \
  -d '{"code":"123456"}'


